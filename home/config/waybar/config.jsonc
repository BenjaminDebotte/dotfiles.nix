{
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 4,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-bottom": 10,
  "modules-left": ["river/tags", "river/layout"],
  "modules-center": ["river/window"],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "bluetooth",
    "backlight",
    "temperature",
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],

  "river/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
  },

  "river/layout": {
    "format": "{}",
    "min-length": 4
  },

  "river/window": {
    "format": "{}",
    "max-length": 50
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [" ", " ", " ", " ", " "]
  },

  "bluetooth": {
    "format": "󰂯 {status}",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂳 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
    "on-click": "blueberry"
  },

  "clock": {
    "timezone": "Europe/Paris",
    "format": " {:%H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%Y-%m-%d}"
  },

  "cpu": {
    "interval": 10,
    "format": " {}%",
    "max-length": 10
  },

  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10
  },

  "temperature": {
    "critical-threshold": 80,
    "format-critical": " {temperatureC}°C",
    "format": " {temperatureC}°C"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " ",
    "on-click": "pavucontrol",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "scroll-step": 5,
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": [" "]
    }
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈁 ",
    "format-disconnected": "󰖪 ",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{signalStrength}%\n{ipaddr}",
    "on-click": "kitty -e nmtui"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "󰳲 {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl -n1 set 5%-",
    "on-click-right": "$HOME/.config/river/toggle-nightlight.sh"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶 ",
      "deactivated": "󰾪 "
    },
    "tooltip": true,
    "tooltip-format-activated": "Idle inhibitor: Active (screen will not lock)",
    "tooltip-format-deactivated": "Idle inhibitor: Inactive"
  }
}
